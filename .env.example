# ローカル開発用（Supabase未設定時はパスワード認証）
ADMIN_PASSWORD=blh2022
ADMIN_SECRET=local-dev-secret

# お問い合わせ先メール（data/site.json の email を上書き）
# CONTACT_EMAIL=info@example.com

# Googleフォーム埋め込みURL（設定するとお問い合わせページにフォームを表示）
# 例: https://docs.google.com/forms/d/e/xxxxxxxx/viewform?embedded=true
# NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=

# Supabase（設定すると Auth 切替 + DocumentStore 有効）
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ドキュメント保存用（サーバ専用。Vercel 等では必ず設定。クライアントに晒さない）
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# 初回セットアップ:
#   1. supabase/app_documents.sql を SQL Editor で実行
#   2. node --env-file=.env.local scripts/seed-app-documents.mjs
